[importlinter]
root_package = pcsa
include_external_packages = True

[importlinter:contract:no-poke-env]
name = Nothing imports poke-env
type = forbidden
source_modules =
    pcsa
forbidden_modules =
    poke_env

[importlinter:contract:no-torch-outside-the-networks]
name = torch only in pcsa.network and pcsa.sprite_training
type = forbidden
source_modules =
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
    pcsa.cg
forbidden_modules =
    torch

[importlinter:contract:champions-gym-behind-cg]
name = champions_gym only in pcsa.cg and pcsa.network
type = forbidden
source_modules =
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
forbidden_modules =
    champions_gym

[importlinter:contract:cg-is-loaded-by-name]
name = Only decide/load.py imports pcsa.cg, and only when the cg Player is asked for
type = forbidden
source_modules =
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
forbidden_modules =
    pcsa.cg
ignore_imports =
    pcsa.decide.load -> pcsa.cg.adapter
