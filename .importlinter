[importlinter]
root_package = pcsa

[importlinter:contract:layers]
name = Layered packages: common <- battle <- phone | sim <- players <- run <- live <- cli
type = layers
layers =
    pcsa.cli
    pcsa.live
    pcsa.run
    pcsa.players
    pcsa.phone | pcsa.sim
    pcsa.battle
    pcsa.common

[importlinter:contract:sprite-training-is-a-leaf]
name = Nothing at runtime imports the sprite trainer (only the `pcsa train` commands do: cli and train_cli)
type = forbidden
source_modules =
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.sim
    pcsa.players
    pcsa.run
    pcsa.live
forbidden_modules =
    pcsa.sprite_training
allow_indirect_imports = False
