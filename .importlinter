[importlinter]
root_package = pcsa
include_external_packages = True

[importlinter:contract:no-poke-env]
name = Nothing imports poke-env
type = forbidden
source_modules =
    pcsa
forbidden_modules =
    poke_env

[importlinter:contract:no-torch-outside-the-networks]
name = torch only in pcsa.network and pcsa.sprite_training
type = forbidden
source_modules =
    pcsa.cli
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
    pcsa.cg
forbidden_modules =
    torch
ignore_imports =
    pcsa.cli -> pcsa.sprite_training.sprite_train

[importlinter:contract:champions-gym-in-the-player-process]
name = champions_gym only in pcsa.cg.serve, pcsa.cg.view and pcsa.network
type = forbidden
source_modules =
    pcsa.cli
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
    pcsa.sprite_training
    pcsa.cg.adapter
    pcsa.cg.fake_cg
    pcsa.cg.messages_log
    pcsa.cg.slots
    pcsa.cg.startup
    pcsa.cg.stream
    pcsa.cg.transport
forbidden_modules =
    champions_gym

[importlinter:contract:cg-is-loaded-by-name]
name = Only decide/load.py imports pcsa.cg, and only when the cg Player is asked for
type = forbidden
source_modules =
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
forbidden_modules =
    pcsa.cg
ignore_imports =
    pcsa.decide.load -> pcsa.cg.adapter

[importlinter:contract:network-is-loaded-by-name]
name = Nothing imports pcsa.network (the player process loads the policy by name)
type = forbidden
source_modules =
    pcsa.cli
    pcsa.common
    pcsa.battle
    pcsa.phone
    pcsa.events
    pcsa.decide
    pcsa.live
    pcsa.run
    pcsa.cg
    pcsa.sprite_training
forbidden_modules =
    pcsa.network

[importlinter:contract:the-dashboard-only-reads-files]
name = The pcsa watch modules import no phone, live, Champions Gym or network code
type = forbidden
source_modules =
    pcsa.run.watch
    pcsa.run.watch_battle
    pcsa.run.watch_belief
    pcsa.run.watch_decisions
    pcsa.run.watch_events
    pcsa.run.watch_log
    pcsa.run.watch_matrix
    pcsa.run.watch_names
    pcsa.run.watch_view
forbidden_modules =
    pcsa.phone
    pcsa.live
    pcsa.cg
    pcsa.network
    pcsa.decide
    pcsa.events
    champions_gym
    torch
    cv2
